# === Sistem Traduceri — API Keys ===
# Copiaza acest fisier ca .env si completeaza valorile reale
# NICIODATA nu urca .env pe GitHub!

# Provider primar — Google Gemini Free Tier
GOOGLE_AI_API_KEY=

# Fallback traducere — Groq
GROQ_API_KEY=

# Fallback vision — Mistral/Pixtral
MISTRAL_API_KEY=

# Optional — Cerebras
CEREBRAS_API_KEY=

# Traducere — DeepL Free (2 chei pt cota dubla)
DEEPL_API_KEY=
DEEPL_API_KEY2=

# Fallback traducere — NLLB (Hugging Face) + OpenRouter
HF_TOKEN=
OPENROUTER_API_KEY=

# === Supabase (log-uri diagnostic + contor Gemini) ===
# Backend (Python) + ruta Next /api/logs — service-role key, DOAR server-side!
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Doar pt CSP in frontend (domeniul Supabase, public)
NEXT_PUBLIC_SUPABASE_URL=

# === Deploy Vercel ===
# URL-ul proiectului API Python (frontend il apeleaza cross-origin)
NEXT_PUBLIC_API_URL=
PYTHON_API_URL=
# Originea permisa la CORS (domeniul frontend). Gol/"*" = permite orice.
ALLOWED_ORIGIN=
# URL public al aplicatiei (folosit ca HTTP-Referer la OpenRouter)
APP_PUBLIC_URL=
