{"formule":{"5":[{"grup":"Puteri","nume":"Puterea unui număr","html":"a<sup>n</sup> = a × a × ... × a (n factori)"},{"grup":"Puteri","nume":"Orice număr la puterea 0","html":"a<sup>0</sup> = 1  (a ≠ 0)"},{"grup":"Puteri","nume":"Orice număr la puterea 1","html":"a<sup>1</sup> = a"},{"grup":"Puteri","nume":"Înmulțirea puterilor cu aceeași bază","html":"a<sup>m</sup> × a<sup>n</sup> = a<sup>m+n</sup>"},{"grup":"Puteri","nume":"Împărțirea puterilor cu aceeași bază","html":"a<sup>m</sup> : a<sup>n</sup> = a<sup>m−n</sup>  (a ≠ 0, m ≥ n)"},{"grup":"Puteri","nume":"Puterea unei puteri","html":"(a<sup>m</sup>)<sup>n</sup> = a<sup>m×n</sup>"},{"grup":"Puteri","nume":"Puterea unui produs","html":"(a × b)<sup>n</sup> = a<sup>n</sup> × b<sup>n</sup>"},{"grup":"Puteri","nume":"Puterea unui raport","html":"(a/b)<sup>n</sup> = a<sup>n</sup>/b<sup>n</sup>  (b ≠ 0)"},{"grup":"Fracții","nume":"Adunarea/scăderea fracțiilor (același numitor)","html":"a/b + c/b = (a + c)/b  ·  a/b − c/b = (a − c)/b  (b ≠ 0)"},{"grup":"Fracții","nume":"Amplificarea unei fracții","html":"a/b = (a × k)/(b × k)  (b ≠ 0, k ≠ 0)"},{"grup":"Fracții","nume":"Simplificarea unei fracții","html":"a/b = (a : k)/(b : k)  (b ≠ 0, k ≠ 0, k divizor comun al lui a și b)"},{"grup":"Fracții","nume":"Înmulțirea fracțiilor","html":"a/b × c/d = (a × c)/(b × d)  (b, d ≠ 0)"},{"grup":"Fracții","nume":"Împărțirea fracțiilor","html":"a/b : c/d = a/b × d/c  (b, c, d ≠ 0)"},{"grup":"Divizibilitate","nume":"c.m.m.d.c. și c.m.m.m.c. (relație)","html":"c.m.m.d.c.(a,b) × c.m.m.m.c.(a,b) = a × b"},{"grup":"Numere","nume":"Modulul (valoarea absolută)","html":"|a| = a, dacă a ≥ 0  ·  |a| = −a, dacă a &lt; 0"},{"grup":"Geometrie","nume":"Perimetrul triunghiului","html":"P = a + b + c"},{"grup":"Geometrie","nume":"Perimetrul pătratului","html":"P = 4 × l"},{"grup":"Geometrie","nume":"Perimetrul dreptunghiului","html":"P = 2 × (L + l)"},{"grup":"Geometrie","nume":"Suma unghiurilor unui triunghi","html":"m(A) + m(B) + m(C) = 180°"},{"grup":"Geometrie","nume":"Unghiuri uzuale","html":"unghi drept = 90°, unghi alungit = 180°, unghi complet = 360°"},{"grup":"Divizibilitate","nume":"Numărul prim (definiție)","html":"p este prim dacă are exact doi divizori naturali: 1 și p"},{"grup":"Divizibilitate","nume":"Descompunerea în factori primi","html":"orice număr natural &gt; 1 se scrie unic ca produs de puteri de numere prime"},{"grup":"Numere","nume":"Ordinea efectuării operațiilor","html":"( )  →  ridicare la putere  →  × și :  →  + și −"},{"grup":"Numere","nume":"Media aritmetică a mai multor numere","html":"m = (a₁ + a₂ + ... + a<sub>n</sub>)/n"},{"grup":"Divizibilitate","nume":"Criteriul de divizibilitate cu 2, 5, 10","html":"cu 2: ultima cifră e pară  ·  cu 5: ultima cifră e 0 sau 5  ·  cu 10: ultima cifră e 0"},{"grup":"Divizibilitate","nume":"Criteriul de divizibilitate cu 3 și 9","html":"cu 3: suma cifrelor e divizibilă cu 3  ·  cu 9: suma cifrelor e divizibilă cu 9"},{"grup":"Fracții zecimale","nume":"Transformarea în fracție ordinară","html":"0,a₁a₂...a<sub>n</sub> = a₁a₂...a<sub>n</sub>/10<sup>n</sup>  (fracție zecimală finită)"},{"grup":"Fracții zecimale","nume":"Adunarea/scăderea numerelor zecimale","html":"se așază virgulă sub virgulă, apoi se adună/scad ca numerele naturale"},{"grup":"Fracții zecimale","nume":"Înmulțirea numerelor zecimale","html":"se înmulțesc ca numere naturale, apoi se separă atâtea zecimale cât suma zecimalelor factorilor"},{"grup":"Fracții zecimale","nume":"Împărțirea numerelor zecimale","html":"se amplifică deîmpărțitul și împărțitorul cu 10<sup>n</sup> astfel încât împărțitorul să devină număr natural"}],"6":[{"grup":"Rapoarte și proporții","nume":"Proporție derivată","html":"a/b = c/d  ⇒  a × d = b × c  (b, d ≠ 0)"},{"grup":"Rapoarte și proporții","nume":"Procente — aflarea a p% din N","html":"p% din N = (p × N)/100"},{"grup":"Rapoarte și proporții","nume":"Regula de trei simplă (direct proporțional)","html":"a → b,  c → x  ⇒  x = (b × c)/a  (a ≠ 0)"},{"grup":"Rapoarte și proporții","nume":"Media aritmetică a două numere","html":"m = (a + b)/2"},{"grup":"Rapoarte și proporții","nume":"Media ponderată","html":"m = (a×p + b×q)/(p + q)  (p + q ≠ 0)"},{"grup":"Numere întregi","nume":"Modulul unui număr întreg","html":"|a| = a, dacă a ≥ 0  ·  |a| = −a, dacă a &lt; 0"},{"grup":"Geometrie","nume":"Aria dreptunghiului","html":"A = L × l"},{"grup":"Geometrie","nume":"Aria pătratului","html":"A = l<sup>2</sup>"},{"grup":"Geometrie","nume":"Aria triunghiului","html":"A = (b × h)/2"},{"grup":"Geometrie","nume":"Lungimea cercului","html":"L = 2 × π × r"},{"grup":"Geometrie","nume":"Aria cercului","html":"A = π × r<sup>2</sup>"},{"grup":"Geometrie","nume":"Unghiuri complementare / suplementare","html":"complementare: suma = 90°  ·  suplementare: suma = 180°"},{"grup":"Geometrie","nume":"Unghiuri opuse la vârf","html":"unghiurile opuse la vârf sunt congruente"},{"grup":"Geometrie","nume":"Unghiuri formate de 2 paralele + secantă","html":"unghiuri alterne interne congruente  ·  unghiuri corespondente congruente"},{"grup":"Geometrie","nume":"Suma unghiurilor unui patrulater convex","html":"m(A) + m(B) + m(C) + m(D) = 360°"},{"grup":"Cerc","nume":"Diametru și rază","html":"D = 2 × r"},{"grup":"Numere raționale","nume":"Regula semnelor la înmulțire/împărțire","html":"(+) × (+) = +  ·  (+) × (−) = −  ·  (−) × (−) = +"},{"grup":"Numere raționale","nume":"Rotunjirea unui număr","html":"dacă prima cifră neglijată ≥ 5 → rotunjire în sus; altfel → rotunjire în jos"},{"grup":"Rapoarte și proporții","nume":"Regula de trei simplă (invers proporțional)","html":"a → b,  c → x  ⇒  x = (a × b)/c  (c ≠ 0)"},{"grup":"Triunghiuri congruente","nume":"Cazurile de congruență","html":"LUL, ULU, LLL — trei perechi de elemente congruente care determină congruența a două triunghiuri"},{"grup":"Linii importante în triunghi","nume":"Mediana","html":"unește un vârf cu mijlocul laturii opuse; cele 3 mediane sunt concurente în centrul de greutate G"},{"grup":"Linii importante în triunghi","nume":"Mediatoarea","html":"perpendiculara pe mijlocul unei laturi; cele 3 mediatoare sunt concurente în centrul cercului circumscris"},{"grup":"Linii importante în triunghi","nume":"Bisectoarea","html":"semidreapta care împarte un unghi în două unghiuri congruente; cele 3 bisectoare sunt concurente în centrul cercului înscris"},{"grup":"Linii importante în triunghi","nume":"Înălțimea","html":"perpendiculara dintr-un vârf pe latura opusă (sau prelungirea ei); cele 3 înălțimi sunt concurente în ortocentru"},{"grup":"Patrulatere","nume":"Proprietăți paralelogram","html":"laturi opuse paralele și congruente · unghiuri opuse congruente · diagonalele se înjumătățesc"},{"grup":"Patrulatere","nume":"Proprietăți romb","html":"paralelogram cu toate laturile congruente · diagonalele sunt perpendiculare și sunt bisectoare ale unghiurilor"},{"grup":"Patrulatere","nume":"Proprietăți trapez","html":"patrulater cu exact o pereche de laturi paralele (bazele)"}],"7":[{"grup":"Radicali","nume":"Radicalul unui produs","html":"√(a × b) = √a × √b  (a, b ≥ 0)"},{"grup":"Radicali","nume":"Radicalul unui raport","html":"√(a/b) = √a / √b  (a ≥ 0, b &gt; 0)"},{"grup":"Radicali","nume":"Scoaterea factorilor de sub radical","html":"√(a<sup>2</sup> × b) = a × √b  (a ≥ 0, b ≥ 0)"},{"grup":"Calcul algebric","nume":"Pătratul unei sume","html":"(a + b)<sup>2</sup> = a<sup>2</sup> + 2ab + b<sup>2</sup>"},{"grup":"Calcul algebric","nume":"Pătratul unei diferențe","html":"(a − b)<sup>2</sup> = a<sup>2</sup> − 2ab + b<sup>2</sup>"},{"grup":"Calcul algebric","nume":"Diferența de pătrate","html":"a<sup>2</sup> − b<sup>2</sup> = (a − b)(a + b)"},{"grup":"Calcul algebric","nume":"Cubul unei sume","html":"(a + b)<sup>3</sup> = a<sup>3</sup> + 3a<sup>2</sup>b + 3ab<sup>2</sup> + b<sup>3</sup>"},{"grup":"Calcul algebric","nume":"Cubul unei diferențe","html":"(a − b)<sup>3</sup> = a<sup>3</sup> − 3a<sup>2</sup>b + 3ab<sup>2</sup> − b<sup>3</sup>"},{"grup":"Calcul algebric","nume":"Suma de cuburi","html":"a<sup>3</sup> + b<sup>3</sup> = (a + b)(a<sup>2</sup> − ab + b<sup>2</sup>)"},{"grup":"Calcul algebric","nume":"Diferența de cuburi","html":"a<sup>3</sup> − b<sup>3</sup> = (a − b)(a<sup>2</sup> + ab + b<sup>2</sup>)"},{"grup":"Ecuații și proporționalitate","nume":"Ecuația de gradul I","html":"ax + b = 0  ⇒  x = −b/a  (a ≠ 0)"},{"grup":"Ecuații și proporționalitate","nume":"Mărimi direct proporționale","html":"y = k × x  (k = constanta de proporționalitate)"},{"grup":"Ecuații și proporționalitate","nume":"Mărimi invers proporționale","html":"y = k/x  (x ≠ 0)"},{"grup":"Triunghi dreptunghic","nume":"Teorema lui Pitagora","html":"a<sup>2</sup> + b<sup>2</sup> = c<sup>2</sup>"},{"grup":"Triunghi dreptunghic","nume":"Teorema înălțimii","html":"h<sup>2</sup> = m × n  (m, n = proiecțiile catetelor pe ipotenuză)"},{"grup":"Triunghi dreptunghic","nume":"Teorema catetei","html":"b<sup>2</sup> = c × n  (n = proiecția catetei b pe ipotenuză)"},{"grup":"Triunghi dreptunghic","nume":"Aria triunghiului dreptunghic","html":"A = (c₁ × c₂)/2"},{"grup":"Patrulatere","nume":"Aria trapezului","html":"A = ((B + b) × h)/2"},{"grup":"Patrulatere","nume":"Aria paralelogramului","html":"A = b × h"},{"grup":"Patrulatere","nume":"Aria rombului","html":"A = (D × d)/2"},{"grup":"Cerc","nume":"Aria cercului","html":"A = π × r<sup>2</sup>"},{"grup":"Triunghiuri congruente","nume":"Cazurile de congruență","html":"LUL, ULU, LLL — trei perechi de elemente congruente care determină congruența a două triunghiuri"},{"grup":"Cerc","nume":"Unghiul la centru","html":"măsura arcului = măsura unghiului la centru corespunzător"},{"grup":"Cerc","nume":"Unghiul înscris în cerc","html":"măsura unghiului înscris = jumătate din măsura arcului cuprins între laturile lui"}],"8":[{"grup":"Sisteme de ecuații","nume":"Sistem de ecuații liniare 2×2","html":"{ ax + by = c ; a′x + b′y = c′ }"},{"grup":"Funcții","nume":"Funcția liniară (introducere)","html":"f(x) = ax + b,  f : ℝ → ℝ  (a ≠ 0)"},{"grup":"Numere reale","nume":"Modulul unui număr real (inecuație)","html":"|x − a| &lt; r  ⇔  x ∈ (a − r, a + r)  (r &gt; 0)"},{"grup":"Triunghiuri","nume":"Linia mijlocie în triunghi","html":"MN ∥ BC  și  MN = BC/2  (M, N = mijloacele laturilor AB, AC)"},{"grup":"Triunghiuri","nume":"Inegalitatea triunghiului","html":"|b − c| &lt; a &lt; b + c"},{"grup":"Asemănare","nume":"Teorema lui Thales","html":"DE ∥ BC  ⇒  AD/AB = AE/AC"},{"grup":"Asemănare","nume":"Raport de arii pt. triunghiuri asemenea","html":"raport arii = k<sup>2</sup>  (k = raportul de asemănare)"},{"grup":"Corpuri geometrice","nume":"Volumul cubului","html":"V = l<sup>3</sup>"},{"grup":"Corpuri geometrice","nume":"Aria totală a cubului","html":"A = 6 × l<sup>2</sup>"},{"grup":"Corpuri geometrice","nume":"Volumul paralelipipedului dreptunghic","html":"V = L × l × h"},{"grup":"Corpuri geometrice","nume":"Aria totală a paralelipipedului","html":"A = 2 × (L×l + L×h + l×h)"},{"grup":"Corpuri geometrice","nume":"Volumul prismei","html":"V = A<sub>bază</sub> × h"},{"grup":"Corpuri geometrice","nume":"Aria laterală a prismei drepte","html":"A<sub>l</sub> = P<sub>bază</sub> × h"},{"grup":"Corpuri geometrice","nume":"Volumul piramidei","html":"V = (1/3) × A<sub>bază</sub> × h"},{"grup":"Corpuri geometrice","nume":"Volumul cilindrului","html":"V = π × r<sup>2</sup> × h"},{"grup":"Corpuri geometrice","nume":"Aria laterală a cilindrului","html":"A<sub>l</sub> = 2 × π × r × h"},{"grup":"Corpuri geometrice","nume":"Aria totală a cilindrului","html":"A<sub>t</sub> = 2 × π × r × (r + h)"},{"grup":"Corpuri geometrice","nume":"Volumul conului","html":"V = (1/3) × π × r<sup>2</sup> × h"},{"grup":"Corpuri geometrice","nume":"Aria laterală a conului","html":"A<sub>l</sub> = π × r × g  (g = generatoarea)"},{"grup":"Corpuri geometrice","nume":"Volumul sferei","html":"V = (4/3) × π × r<sup>3</sup>"},{"grup":"Corpuri geometrice","nume":"Aria sferei","html":"A = 4 × π × r<sup>2</sup>"},{"grup":"Patrulatere","nume":"Proprietăți paralelogram","html":"diagonalele paralelogramului se înjumătățesc"},{"grup":"Triunghiuri congruente","nume":"Cazuri de congruență (triunghi dreptunghic)","html":"CC (catetă-catetă), CU (catetă-unghi), IC (ipotenuză-catetă), IU (ipotenuză-unghi)"},{"grup":"Trigonometrie","nume":"Sinus, cosinus, tangentă, cotangentă","html":"sin A = cateta opusă/ipotenuză · cos A = cateta alăturată/ipotenuză · tg A = cateta opusă/cateta alăturată · ctg A = cateta alăturată/cateta opusă"},{"grup":"Trigonometrie","nume":"Valori notabile — 30°, 45°, 60°","html":"sin 30° = 1/2 · sin 45° = √2/2 · sin 60° = √3/2 · cos 30° = √3/2 · cos 45° = √2/2 · cos 60° = 1/2"},{"grup":"Statistică","nume":"Probabilitatea unui eveniment (cazuri egal probabile)","html":"P(A) = nr. cazuri favorabile/nr. cazuri posibile"},{"grup":"Statistică","nume":"Frecvența relativă","html":"f = nr. apariții/nr. total observații  (frecvență procentuală = f × 100%)"}],"9":[{"grup":"Șiruri","nume":"Progresie aritmetică — termen general","html":"a<sub>n</sub> = a₁ + (n − 1) × r"},{"grup":"Șiruri","nume":"Progresie aritmetică — sumă","html":"S<sub>n</sub> = n × (a₁ + a<sub>n</sub>)/2"},{"grup":"Șiruri","nume":"Progresie geometrică — termen general","html":"a<sub>n</sub> = a₁ × r<sup>n−1</sup>"},{"grup":"Șiruri","nume":"Progresie geometrică — sumă","html":"S<sub>n</sub> = a₁ × (r<sup>n</sup> − 1)/(r − 1)  (r ≠ 1)"},{"grup":"Funcții","nume":"Funcția de gradul I","html":"f(x) = ax + b  (a ≠ 0)"},{"grup":"Funcții","nume":"Monotonia funcției de gradul I","html":"a &gt; 0 ⇒ f crescătoare  ·  a &lt; 0 ⇒ f descrescătoare"},{"grup":"Funcții","nume":"Funcția de gradul II","html":"f(x) = ax<sup>2</sup> + bx + c  (a ≠ 0)"},{"grup":"Ecuația de gradul II","nume":"Discriminant","html":"Δ = b<sup>2</sup> − 4ac"},{"grup":"Ecuația de gradul II","nume":"Formula rădăcinilor","html":"x₁,₂ = (−b ± √Δ)/(2a)"},{"grup":"Ecuația de gradul II","nume":"Relațiile lui Viète","html":"x₁ + x₂ = −b/a  ·  x₁ × x₂ = c/a"},{"grup":"Ecuația de gradul II","nume":"Vârful parabolei","html":"V(−b/(2a), −Δ/(4a))"},{"grup":"Ecuația de gradul II","nume":"Descompunerea trinomului","html":"ax<sup>2</sup> + bx + c = a(x − x₁)(x − x₂)"},{"grup":"Geometrie analitică","nume":"Distanța dintre două puncte","html":"d = √((x₂ − x₁)<sup>2</sup> + (y₂ − y₁)<sup>2</sup>)"},{"grup":"Geometrie analitică","nume":"Mijlocul unui segment","html":"M((x₁ + x₂)/2, (y₁ + y₂)/2)"},{"grup":"Vectori","nume":"Modulul unui vector","html":"|v⃗| = √(x<sup>2</sup> + y<sup>2</sup>)"},{"grup":"Vectori","nume":"Suma a doi vectori","html":"u⃗(x₁,y₁) + v⃗(x₂,y₂) = (x₁+x₂, y₁+y₂)"},{"grup":"Vectori","nume":"Produsul unui vector cu un scalar","html":"k × u⃗(x,y) = (k×x, k×y)"},{"grup":"Vectori","nume":"Coliniaritatea a doi vectori","html":"u⃗(x₁,y₁), v⃗(x₂,y₂) coliniari  ⇔  x₁×y₂ − x₂×y₁ = 0"},{"grup":"Trigonometrie","nume":"Sinus, cosinus, tangentă (triunghi dreptunghic)","html":"sin A = cateta opusă/ipotenuză  ·  cos A = cateta alăturată/ipotenuză  ·  tg A = cateta opusă/cateta alăturată"},{"grup":"Trigonometrie","nume":"Valori notabile — 30°, 45°, 60°","html":"sin 30° = 1/2 · sin 45° = √2/2 · sin 60° = √3/2"},{"grup":"Trigonometrie","nume":"Teorema sinusurilor (triunghi oarecare)","html":"a/sin A = b/sin B = c/sin C = 2R  (R = raza cercului circumscris)"},{"grup":"Trigonometrie","nume":"Teorema cosinusului (triunghi oarecare)","html":"a<sup>2</sup> = b<sup>2</sup> + c<sup>2</sup> − 2×b×c×cos A"},{"grup":"Trigonometrie","nume":"Aria triunghiului prin sinus","html":"A = (1/2) × b × c × sin A"},{"grup":"Funcții","nume":"Funcție injectivă / surjectivă / bijectivă","html":"injectivă: x₁≠x₂ ⇒ f(x₁)≠f(x₂)  ·  surjectivă: ∀y∈codomeniu ∃x cu f(x)=y  ·  bijectivă: injectivă și surjectivă"},{"grup":"Ecuația de gradul II","nume":"Semnul funcției de gradul II","html":"dacă Δ &gt; 0: semn contrar lui a între rădăcini, semn lui a în rest"}],"10":[{"grup":"Numere complexe","nume":"Forma algebrică","html":"z = a + b × i,  i<sup>2</sup> = −1"},{"grup":"Numere complexe","nume":"Modulul unui număr complex","html":"|z| = √(a<sup>2</sup> + b<sup>2</sup>)"},{"grup":"Numere complexe","nume":"Conjugatul","html":"z̄ = a − b × i"},{"grup":"Numere complexe","nume":"Forma trigonometrică","html":"z = r × (cos θ + i × sin θ)"},{"grup":"Numere complexe","nume":"Formula lui Moivre","html":"z<sup>n</sup> = r<sup>n</sup> × (cos(nθ) + i × sin(nθ))"},{"grup":"Funcții","nume":"Funcția exponențială","html":"f(x) = a<sup>x</sup>  (a &gt; 0, a ≠ 1)"},{"grup":"Funcții","nume":"Funcția logaritmică","html":"f(x) = log<sub>a</sub>x  (a &gt; 0, a ≠ 1, x &gt; 0)"},{"grup":"Logaritmi","nume":"Logaritmul unui produs","html":"log<sub>a</sub>(x × y) = log<sub>a</sub>x + log<sub>a</sub>y  (x, y &gt; 0)"},{"grup":"Logaritmi","nume":"Logaritmul unui raport","html":"log<sub>a</sub>(x/y) = log<sub>a</sub>x − log<sub>a</sub>y  (x, y &gt; 0)"},{"grup":"Logaritmi","nume":"Logaritmul unei puteri","html":"log<sub>a</sub>(x<sup>n</sup>) = n × log<sub>a</sub>x  (x &gt; 0, a &gt; 0, a ≠ 1)"},{"grup":"Logaritmi","nume":"Schimbarea bazei","html":"log<sub>a</sub>b = log<sub>c</sub>b / log<sub>c</sub>a  (a, b, c &gt; 0, a ≠ 1, c ≠ 1)"},{"grup":"Geometrie analitică","nume":"Ecuația generală a dreptei","html":"ax + by + c = 0  ((a, b) ≠ (0, 0))"},{"grup":"Geometrie analitică","nume":"Panta unei drepte","html":"m = (y₂ − y₁)/(x₂ − x₁)  (x₁ ≠ x₂)"},{"grup":"Geometrie analitică","nume":"Condiția de paralelism","html":"d₁ ∥ d₂  ⇔  m₁ = m₂"},{"grup":"Geometrie analitică","nume":"Condiția de perpendicularitate","html":"d₁ ⊥ d₂  ⇔  m₁ × m₂ = −1"},{"grup":"Trigonometrie","nume":"Relația fundamentală","html":"sin<sup>2</sup>x + cos<sup>2</sup>x = 1"},{"grup":"Trigonometrie","nume":"Formule de adunare","html":"sin(a ± b) = sin a·cos b ± cos a·sin b  ·  cos(a ± b) = cos a·cos b ∓ sin a·sin b"},{"grup":"Trigonometrie","nume":"Formule de dublare","html":"sin 2x = 2·sin x·cos x  ·  cos 2x = cos<sup>2</sup>x − sin<sup>2</sup>x"},{"grup":"Trigonometrie","nume":"Tangenta sumei","html":"tg(a ± b) = (tg a ± tg b)/(1 ∓ tg a·tg b)"},{"grup":"Trigonometrie","nume":"Formule de înjumătățire","html":"sin(x/2) = ±√((1 − cos x)/2)  ·  cos(x/2) = ±√((1 + cos x)/2)"},{"grup":"Ecuații exponențiale/logaritmice","nume":"Ecuație exponențială de bază","html":"a<sup>x</sup> = a<sup>y</sup>  ⇒  x = y  (a &gt; 0, a ≠ 1)"},{"grup":"Ecuații exponențiale/logaritmice","nume":"Ecuație logaritmică de bază","html":"log<sub>a</sub>x = log<sub>a</sub>y  ⇒  x = y  (a &gt; 0, a ≠ 1, x, y &gt; 0)"},{"grup":"Ecuații trigonometrice","nume":"Ecuația sin x = a","html":"sin x = a  (−1 ≤ a ≤ 1)  ⇒  x = (−1)<sup>k</sup> arcsin(a) + kπ,  k ∈ ℤ"},{"grup":"Ecuații trigonometrice","nume":"Ecuația cos x = a","html":"cos x = a  (−1 ≤ a ≤ 1)  ⇒  x = ± arccos(a) + 2kπ,  k ∈ ℤ"},{"grup":"Ecuații trigonometrice","nume":"Ecuația tg x = a","html":"tg x = a  ⇒  x = arctg(a) + kπ,  k ∈ ℤ"},{"grup":"Ecuații exponențiale/logaritmice","nume":"Inecuație exponențială","html":"a<sup>x</sup> &gt; a<sup>y</sup>  ⇒  x &gt; y  dacă a &gt; 1;  x &lt; y  dacă 0 &lt; a &lt; 1"},{"grup":"Ecuații exponențiale/logaritmice","nume":"Inecuație logaritmică","html":"log<sub>a</sub>x &gt; log<sub>a</sub>y  ⇒  x &gt; y  dacă a &gt; 1;  x &lt; y  dacă 0 &lt; a &lt; 1  (x, y &gt; 0)"}],"11":[{"grup":"Combinatorică","nume":"Permutări","html":"P<sub>n</sub> = n!"},{"grup":"Combinatorică","nume":"Aranjamente","html":"A<sub>n</sub><sup>k</sup> = n!/(n − k)!"},{"grup":"Combinatorică","nume":"Combinări","html":"C<sub>n</sub><sup>k</sup> = n!/[k!(n − k)!]"},{"grup":"Combinatorică","nume":"Proprietatea combinărilor","html":"C<sub>n</sub><sup>k</sup> = C<sub>n</sub><sup>n−k</sup>"},{"grup":"Combinatorică","nume":"Binomul lui Newton","html":"(a + b)<sup>n</sup> = Σ C<sub>n</sub><sup>k</sup> a<sup>n−k</sup>b<sup>k</sup>"},{"grup":"Algebră liniară","nume":"Determinant de ordin 2","html":"det A = a×d − b×c,  A = [[a, b], [c, d]]"},{"grup":"Algebră liniară","nume":"Regula lui Sarrus (ordin 3)","html":"det A = aei + bfg + cdh − ceg − bdi − afh"},{"grup":"Limite","nume":"Limita unui șir (notație)","html":"lim (n→∞) a<sub>n</sub> = L"},{"grup":"Limite","nume":"Limita fundamentală trigonometrică","html":"lim (x→0) (sin x)/x = 1"},{"grup":"Derivate","nume":"Derivata — definiție","html":"f′(x) = lim (h→0) [f(x + h) − f(x)]/h"},{"grup":"Derivate","nume":"Reguli de derivare","html":"(f ± g)′ = f′ ± g′  ·  (f×g)′ = f′g + fg′  ·  (f/g)′ = (f′g − fg′)/g<sup>2</sup>  (g ≠ 0)"},{"grup":"Derivate","nume":"Derivata funcției compuse","html":"(f∘g)′(x) = f′(g(x)) × g′(x)"},{"grup":"Derivate","nume":"Derivate uzuale — puteri și exponențiale","html":"(x<sup>n</sup>)′ = n×x<sup>n−1</sup>  ·  (e<sup>x</sup>)′ = e<sup>x</sup>  ·  (ln x)′ = 1/x"},{"grup":"Derivate","nume":"Derivate uzuale — trigonometrice","html":"(sin x)′ = cos x  ·  (cos x)′ = −sin x  ·  (tg x)′ = 1/cos<sup>2</sup>x"},{"grup":"Derivate","nume":"Ecuația tangentei la grafic","html":"y − f(a) = f′(a) × (x − a)"},{"grup":"Algebră liniară","nume":"Adunarea matricelor","html":"(A + B)<sub>ij</sub> = A<sub>ij</sub> + B<sub>ij</sub>  (A, B de aceeași dimensiune)"},{"grup":"Algebră liniară","nume":"Matrice inversabilă","html":"A × A<sup>−1</sup> = A<sup>−1</sup> × A = I  (A inversabilă ⇔ det A ≠ 0)"},{"grup":"Derivate — aplicații","nume":"Monotonia cu derivata întâi","html":"f′(x) &gt; 0 pe I  ⇒  f crescătoare pe I  ·  f′(x) &lt; 0 pe I  ⇒  f descrescătoare pe I"},{"grup":"Derivate — aplicații","nume":"Teorema lui Fermat (condiție necesară)","html":"x₀ punct interior de extrem, f derivabilă în x₀  ⇒  f′(x₀) = 0"},{"grup":"Derivate — aplicații","nume":"Condiție suficientă de extrem","html":"f′(x₀) = 0 și f′ își schimbă semnul în x₀  ⇒  x₀ e punct de extrem"},{"grup":"Derivate — aplicații","nume":"Concavitate/convexitate","html":"f″(x) &gt; 0 pe I  ⇒  f convexă pe I  ·  f″(x) &lt; 0 pe I  ⇒  f concavă pe I"},{"grup":"Sisteme liniare","nume":"Regula lui Cramer (sistem 2×2)","html":"Δ = a₁b₂ − a₂b₁,  Δ<sub>x</sub> = c₁b₂ − c₂b₁,  Δ<sub>y</sub> = a₁c₂ − a₂c₁  ⇒  x = Δ<sub>x</sub>/Δ,  y = Δ<sub>y</sub>/Δ  (Δ ≠ 0)"},{"grup":"Algebră liniară","nume":"Înmulțirea matricelor","html":"(A × B)<sub>ij</sub> = Σ<sub>k</sub> A<sub>ik</sub> × B<sub>kj</sub>  (A de tip m×n, B de tip n×p)"},{"grup":"Limite","nume":"Limite fundamentale (numărul e)","html":"lim (x→∞) (1 + 1/x)<sup>x</sup> = e  ·  lim (x→0) ln(1+x)/x = 1  ·  lim (x→0) (e<sup>x</sup>−1)/x = 1"},{"grup":"Limite","nume":"Cazuri de nedeterminare","html":"0/0,  ∞/∞,  ∞ − ∞,  0 × ∞,  1<sup>∞</sup>,  0<sup>0</sup>,  ∞<sup>0</sup>"},{"grup":"Continuitate","nume":"Funcție continuă într-un punct","html":"f e continuă în x₀  ⇔  lim (x→x₀) f(x) = f(x₀)  (limitele laterale sunt egale între ele și cu f(x₀))"},{"grup":"Asimptote","nume":"Asimptotă orizontală","html":"y = L este asimptotă orizontală spre +∞ (sau −∞) dacă lim (x→+∞) f(x) = L  (calculat separat pe fiecare direcție; L finit)"},{"grup":"Asimptote","nume":"Asimptotă verticală","html":"x = a este asimptotă verticală dacă cel puțin una din limitele laterale lim (x→a, x&lt;a) f(x) sau lim (x→a, x&gt;a) f(x) este ±∞"},{"grup":"Asimptote","nume":"Asimptotă oblică","html":"y = mx + n (spre +∞ sau −∞), unde m = lim f(x)/x  și  n = lim [f(x) − mx]  (m, n finite, m ≠ 0; calculate separat pe fiecare direcție)"}],"12":[{"grup":"Primitive","nume":"Primitivă — definiție","html":"∫f(x)dx = F(x) + C,  unde F′ = f"},{"grup":"Primitive","nume":"Integrale uzuale — puteri","html":"∫x<sup>n</sup>dx = x<sup>n+1</sup>/(n+1) + C  (n ≠ −1)  ·  ∫(1/x)dx = ln|x| + C"},{"grup":"Primitive","nume":"Integrale uzuale — exponențiale","html":"∫e<sup>x</sup>dx = e<sup>x</sup> + C"},{"grup":"Primitive","nume":"Integrale uzuale — trigonometrice","html":"∫sin x dx = −cos x + C  ·  ∫cos x dx = sin x + C  ·  ∫(1/cos<sup>2</sup>x)dx = tg x + C"},{"grup":"Primitive","nume":"Integrale uzuale — funcții inverse","html":"∫(1/(1+x<sup>2</sup>))dx = arctg x + C  ·  ∫(1/√(1−x<sup>2</sup>))dx = arcsin x + C  (−1 &lt; x &lt; 1)"},{"grup":"Primitive","nume":"Integrarea prin părți","html":"∫u × v′ dx = u × v − ∫u′ × v dx"},{"grup":"Integrala definită","nume":"Formula Leibniz-Newton","html":"∫[a,b] f(x)dx = F(b) − F(a)"},{"grup":"Integrala definită","nume":"Aria subgraficului","html":"A = ∫[a,b] f(x)dx  (f ≥ 0)"},{"grup":"Integrala definită","nume":"Aria dintre două grafice","html":"A = ∫[a,b] |f(x) − g(x)|dx"},{"grup":"Integrala definită","nume":"Volumul corpului de rotație","html":"V = π × ∫[a,b] f<sup>2</sup>(x)dx"},{"grup":"Probabilități","nume":"Probabilitatea unui eveniment (Laplace)","html":"P(A) = |A|/|Ω|  (cazuri egal probabile: nr. cazuri favorabile/nr. cazuri posibile)"},{"grup":"Probabilități","nume":"Probabilitatea reuniunii","html":"P(A ∪ B) = P(A) + P(B) − P(A ∩ B)"},{"grup":"Probabilități","nume":"Probabilitatea condiționată","html":"P(A|B) = P(A ∩ B)/P(B)  (P(B) &gt; 0)"},{"grup":"Probabilități","nume":"Evenimente independente","html":"P(A ∩ B) = P(A) × P(B)"},{"grup":"Structuri algebrice","nume":"Grup (definiție)","html":"(G, ∗) e grup dacă: ∗ e lege de compoziție internă pe G, e asociativă, are element neutru și orice element are simetric"},{"grup":"Structuri algebrice","nume":"Inel și corp (definiție)","html":"inel = grup abelian la + și monoid la ×, cu distributivitate  ·  corp comutativ = inel comutativ, unitar (1 ≠ 0), cu orice element nenul inversabil"},{"grup":"Primitive","nume":"Schimbarea de variabilă (substituție)","html":"∫f(g(x)) × g′(x) dx = ∫f(u) du,  unde u = g(x)"},{"grup":"Polinoame","nume":"Teorema împărțirii cu rest","html":"A = B × Q + R,  grad(R) &lt; grad(B)  (Q = câtul, R = restul)"},{"grup":"Polinoame","nume":"Teorema lui Bézout","html":"restul împărțirii lui P(x) la (x − a) este P(a)  ⇒  a e rădăcină ⇔ P(a) = 0"},{"grup":"Polinoame","nume":"Schema lui Horner","html":"algoritm rapid pentru câtul și restul împărțirii unui polinom la (x − a)"},{"grup":"Probabilități","nume":"Media unei variabile aleatoare discrete","html":"M(X) = x₁×p₁ + x₂×p₂ + ... + x<sub>n</sub>×p<sub>n</sub>"},{"grup":"Probabilități","nume":"Dispersia unei variabile aleatoare","html":"D(X) = M(X<sup>2</sup>) − [M(X)]<sup>2</sup>"},{"grup":"Probabilități","nume":"Schema lui Bernoulli","html":"P(k) = C<sub>n</sub><sup>k</sup> × p<sup>k</sup> × (1 − p)<sup>n−k</sup>  (probabilitatea a k succese din n încercări independente)"},{"grup":"Polinoame","nume":"Ecuație binomă","html":"x<sup>n</sup> = a  se rezolvă cu rădăcinile de ordin n ale lui a (în ℂ)"},{"grup":"Polinoame","nume":"Ecuație reciprocă (grad 4)","html":"ax<sup>4</sup> + bx<sup>3</sup> + cx<sup>2</sup> + bx + a = 0  se rezolvă prin substituția y = x + 1/x  (x ≠ 0)"}]},"symbols":[{"s":"±","label":"± (plus-minus)"},{"s":"×","label":"× (înmulțire)"},{"s":"÷","label":"÷ (împărțire)"},{"s":"≠","label":"≠ (diferit)"},{"s":"≤","label":"≤ (mai mic sau egal)"},{"s":"≥","label":"≥ (mai mare sau egal)"},{"s":"≈","label":"≈ (aproximativ egal)"},{"s":"≡","label":"≡ (identic / congruent modulo)"},{"s":"∝","label":"∝ (direct proporțional cu)"},{"s":"∞","label":"∞ (infinit)"},{"s":"%","label":"% (procent)"},{"s":"‰","label":"‰ (la mie)"},{"s":"⌊⌋","label":"⌊ ⌋ (parte întreagă)"},{"s":"⌈⌉","label":"⌈ ⌉ (rotunjire în sus)"},{"s":"∣","label":"∣ (divide)"},{"s":"∤","label":"∤ (nu divide)"},{"s":"√","label":"√ (radical de ordin 2)"},{"s":"∛","label":"∛ (radical de ordin 3)"},{"s":"∜","label":"∜ (radical de ordin 4)"},{"s":"π","label":"π (pi)"},{"s":"e","label":"e (numărul lui Euler)"},{"s":"Σ","label":"Σ (sumă)"},{"s":"∏","label":"∏ (produs)"},{"s":"∫","label":"∫ (integrală)"},{"s":"∬","label":"∬ (integrală dublă)"},{"s":"∮","label":"∮ (integrală pe contur)"},{"s":"∂","label":"∂ (derivată parțială)"},{"s":"∇","label":"∇ (nabla)"},{"s":"Δ","label":"Δ (delta, variație)"},{"s":"lim","label":"lim (limită)"},{"s":"→","label":"→ (tinde către)"},{"s":"↦","label":"↦ (funcția asociază)"},{"s":"′","label":"′ (derivata întâi)"},{"s":"″","label":"″ (derivata a doua)"},{"s":"∈","label":"∈ (aparține)"},{"s":"∉","label":"∉ (nu aparține)"},{"s":"⊂","label":"⊂ (inclus strict)"},{"s":"⊆","label":"⊆ (inclus)"},{"s":"⊃"