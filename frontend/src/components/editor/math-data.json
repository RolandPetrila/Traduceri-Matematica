,{"s":"φ","label":"φ (fi)"},{"s":"ψ","label":"ψ (psi)"},{"s":"ω","label":"ω (omega mic)"},{"s":"Φ","label":"Φ (fi mare)"},{"s":"Ψ","label":"Ψ (psi mare)"},{"s":"Θ","label":"Θ (theta mare)"},{"s":"Λ","label":"Λ (lambda mare)"}]}