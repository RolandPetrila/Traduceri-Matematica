{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p public && echo '<!doctype html><meta charset=utf-8><title>Traduceri API</title><body>API OK - functiile Python sunt la /api/*</body>' > public/index.html",
  "installCommand": "pip install --break-system-packages -r requirements.txt",
  "functions": {
    "api/*.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/translate-text", "destination": "/api/translate_text" },
    { "source": "/api/deepl-usage", "destination": "/api/deepl_usage" },
    { "source": "/api/gemini-usage", "destination": "/api/gemini_usage" }
  ]
}
